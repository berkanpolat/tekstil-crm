# ==========================================================================
# Tekstil A.Ş. CRM — ortam degiskenleri
# Bu dosyayi kopyalayip `.env` olarak kaydedin ve degerleri doldurun.
# `.env` dosyasi git'e ISLENMEZ (bkz. .gitignore).
# ==========================================================================

# --- Supabase (istemci tarafi — tarayiciya gomulur, yalnizca public degerler) ---
# Supabase proje panelinden: Project Settings > API
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ==========================================================================
# Asagidakiler YALNIZCA yerel gelistirme / CI arac zinciri icindir.
# Uygulama koduna (VITE_ onekli olmayanlar) tarayiciya gomulmez.
# ==========================================================================

# --- Supabase CLI (migration push / tip uretimi icin) ---
# `supabase link --project-ref <ref>` ile baglanti kurulur.
# Proje ref: Supabase panel URL'sindeki alt alan adi.
SUPABASE_PROJECT_REF=<proje-ref>

# Veritabani sifresi (supabase db push sirasinda sorulur; CI icin buraya konur).
# GIZLI — asla paylasilmaz, .env icinde kalir.
SUPABASE_DB_PASSWORD=<db-sifresi>

# --- service_role anahtari BURADA YOKTUR (bilerek) ---
# Ayricalikli islemler (kullanici olusturma, sifre sifirlama, pasiflestirme)
# Edge Function'lara tasindi. service_role anahtari YALNIZCA Supabase secrets
# icinde durur ve Edge runtime'a otomatik enjekte edilir. Ne bu .env'e, ne de
# VITE_ onekli bir degiskene ASLA konmaz (frontend'e sizmamasi icin).
