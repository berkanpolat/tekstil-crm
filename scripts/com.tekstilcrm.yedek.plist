<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tekstilcrm.yedek</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/berkanpolatcetiner/tekstil-crm/scripts/yedek-al.sh</string>
    </array>

    <!-- Her gün 09:00. Bu saatte Mac kapalı/uykudaysa launchd işi
         bir sonraki açılış/uyanışta telafi olarak çalıştırır. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/berkanpolatcetiner/tekstil-crm-yedekler/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/berkanpolatcetiner/tekstil-crm-yedekler/logs/launchd.err.log</string>
</dict>
</plist>
